[gd_scene load_steps=1 format=3]


[node name="Tab" type="ScrollContainer"]
horizontal_scroll_mode = 0
follow_focus = true

[node name="Padding" type="MarginContainer" parent="."]
size_flags_horizontal = 3
theme_override_constants/margin_left = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_top = 28
theme_override_constants/margin_bottom = 28

[node name="Content" type="VBoxContainer" parent="Padding"]
theme_override_constants/separation = 16


[gd_scene load_steps=4 format=3]
[ext_resource type="Theme" path="res://ui/theme/party_theme.tres" id="theme"]
[ext_resource type="StyleBox" path="res://ui/theme/card.tres" id="card"]
[ext_resource type="StyleBox" path="res://ui/theme/muted.tres" id="muted"]

[node name="Wallet" type="PanelContainer"]
theme = ExtResource("theme")
theme_override_styles/panel = ExtResource("card")
custom_minimum_size = Vector2(460, 104)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_bottom = 20

[node name="Values" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Money" type="VBoxContainer" parent="Margin/Values"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Margin/Values/Money"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "当前金钱"
theme_type_variation = &"PartyLabelMicro"

[node name="Value" type="Label" parent="Margin/Values/Money"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "0"
theme_type_variation = &"PartyLabelSection"
text_overrun_behavior = 3
custom_minimum_size = Vector2(160, 0)

[node name="Diamonds" type="VBoxContainer" parent="Margin/Values"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Margin/Values/Diamonds"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "钻石"
theme_type_variation = &"PartyLabelMicro"

[node name="Value" type="Label" parent="Margin/Values/Diamonds"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "0"
theme_type_variation = &"PartyLabelSection"
text_overrun_behavior = 3
custom_minimum_size = Vector2(160, 0)

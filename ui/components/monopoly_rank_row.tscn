[gd_scene load_steps=4 format=3]
[ext_resource type="Theme" path="res://ui/theme/party_theme.tres" id="theme"]
[ext_resource type="StyleBox" path="res://ui/theme/card.tres" id="card"]
[ext_resource type="StyleBox" path="res://ui/theme/muted.tres" id="muted"]

[node name="RankRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 60)
theme = ExtResource("theme")
theme_override_styles/panel = ExtResource("muted")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Rank" type="Label" parent="Margin/Row"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "01"
custom_minimum_size = Vector2(34, 0)
theme_type_variation = &"PartyLabelMicro"

[node name="Name" type="Label" parent="Margin/Row"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "玩家"
size_flags_horizontal = 3
text_overrun_behavior = 3
custom_minimum_size = Vector2(100, 0)

[node name="Value" type="Label" parent="Margin/Row"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "0"
custom_minimum_size = Vector2(90, 0)
horizontal_alignment = 2
text_overrun_behavior = 3
theme_type_variation = &"PartyLabelMicro"

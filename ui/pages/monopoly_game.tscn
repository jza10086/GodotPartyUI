[gd_scene load_steps=8 format=3]
[ext_resource type="Theme" path="res://ui/theme/party_theme.tres" id="theme"]
[ext_resource type="StyleBox" path="res://ui/theme/card.tres" id="card"]
[ext_resource type="StyleBox" path="res://ui/theme/muted.tres" id="muted"]
[ext_resource type="Script" path="res://ui/pages/monopoly_game.gd" id="script"]
[ext_resource type="PackedScene" path="res://ui/components/monopoly_wallet.tscn" id="wallet"]
[ext_resource type="PackedScene" path="res://ui/components/monopoly_event_modal.tscn" id="event"]

[ext_resource type="StyleBox" path="res://ui/theme/monopoly_option_normal.tres" id="hint"]
[node name="MonopolyHUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Wallet" parent="." instance=ExtResource("wallet")]
layout_mode = 1
offset_left = 32.0
offset_top = 32.0
offset_right = 492.0
offset_bottom = 136.0

[node name="Leaderboard" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -392.0
offset_top = 32.0
offset_right = -32.0
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Toggle" type="Button" parent="Leaderboard"]
layout_mode = 2
custom_minimum_size = Vector2(360, 58)
theme_type_variation = &"PartyButtonSetting"
text = "排行榜  ·  0 人  ▾"

[node name="Body" type="PanelContainer" parent="Leaderboard"]
layout_mode = 2
theme_override_styles/panel = ExtResource("card")

[node name="Margin" type="MarginContainer" parent="Leaderboard/Body"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_bottom = 12

[node name="Rows" type="VBoxContainer" parent="Leaderboard/Body/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Empty" type="Label" parent="Leaderboard/Body/Margin/Rows"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "暂无排行"


[node name="Inventory" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = -390.0
offset_right = 452.0
offset_bottom = -32.0
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Body" type="PanelContainer" parent="Inventory"]
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = ExtResource("card")

[node name="Margin" type="MarginContainer" parent="Inventory/Body"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_bottom = 16

[node name="Scroll" type="ScrollContainer" parent="Inventory/Body/Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Items" type="VBoxContainer" parent="Inventory/Body/Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Empty" type="Label" parent="Inventory/Body/Margin/Scroll/Items"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "背包是空的"


[node name="Toggle" type="Button" parent="Inventory"]
layout_mode = 2
custom_minimum_size = Vector2(420, 64)
theme_type_variation = &"PartyButtonSetting"
text = "道具背包  ·  0  ▾"

[node name="Actions" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 1.0
anchor_right = 1.0
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = -392.0
offset_right = -32.0
offset_top = -390.0
offset_bottom = -32.0
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Scroll" type="ScrollContainer" parent="Actions"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Options" type="VBoxContainer" parent="Actions/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Hint" type="Label" parent="Actions"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PartyLabelNote"
text = "等待游戏状态"
theme_override_styles/normal = ExtResource("hint")
theme_type_variation = &"PartyLabelMicro"
text_overrun_behavior = 3

[node name="Roll" type="Button" parent="Actions"]
layout_mode = 2
custom_minimum_size = Vector2(360, 78)
theme_type_variation = &"PartyButtonSettingPrimary"
text = "掷骰子"
disabled = true

[node name="EventModal" parent="." instance=ExtResource("event")]
layout_mode = 1
